# ==============================================================================
# Aneevarp DocAI - Environment Configuration Template
# Google Cloud Gen AI Ideathon (APAC Edition)
# ==============================================================================

# [Required] Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# [Optional] Application Environment & Server Settings
ENV=production
PORT=8080
HOST=0.0.0.0

# [Optional] Security & CORS Settings
# Comma-separated list of permitted origins
ALLOWED_ORIGINS=https://aneevarpsolutions.vercel.app,https://aneevarp-docai.web.app

# [Optional] Maximum File Upload Size in Megabytes (Default: 20MB)
MAX_FILE_SIZE_MB=20
